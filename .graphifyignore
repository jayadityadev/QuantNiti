competitor_analysis/
docs/pdfs/
docs/review/
docs/research_paper/

# Mobile Capacitor Android native build
android/

# Build artifacts, caches, and database
data/cache/
src/app/static/dist/
*.parquet
*.db
*.sqlite3

# Node & Python dependencies and caches
node_modules/
.venv/
.pytest_cache/
__pycache__/
